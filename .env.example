# Обычно этот файл заполнять руками не нужно: при первом запуске start.bat
# (или python bot.py) мастер настройки сам создаст .env.
# Файл .env НЕ коммитится — в нём секреты.

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Telegram id администраторов через запятую (мастер определит сам)
ADMIN_IDS=123456789

# Как бот на домашнем ПК становится доступен из интернета:
#   cloudflared — бесплатно, без регистрации (скачается само)
#   tuna        — серверы в России, нужен TUNA_TOKEN с https://my.tuna.am/token
#   off         — свой адрес в PUBLIC_URL (VPS, домен, ngrok)
TUNNEL=cloudflared
TUNA_TOKEN=
PUBLIC_URL=

# Где лежит страница бронирования. Пусто — показывать прямо с бота.
# Если на Vercel старая версия, бот сам переключится на свою страницу.
WEBAPP_URL=https://toxic-skill.vercel.app

# Часовой пояс и название клуба
CLUB_TZ=Europe/Moscow
CLUB_NAME=Toxic Skill Club

# Порт локального веб-сервера
WEB_PORT=8080

# Только для разработки: API без входа через Telegram
DEV_MODE=0
