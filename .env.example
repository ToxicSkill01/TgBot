# Скопируйте этот файл в .env и заполните. Файл .env НЕ коммитится.

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Telegram id администраторов через запятую (узнать свой id: @userinfobot)
ADMIN_IDS=123456789

# Публичный https-адрес бота (туннель или домен), см. README
# cloudflared tunnel --url http://localhost:8080  ->  https://xxxx.trycloudflare.com
PUBLIC_URL=https://xxxx.trycloudflare.com

# Где лежит WebApp. Пусто — WebApp отдаёт сам бот по PUBLIC_URL
WEBAPP_URL=https://toxic-skill.vercel.app

# Часовой пояс клуба
CLUB_TZ=Europe/Moscow
CLUB_NAME=Toxic Skill Club

# Порт локального веб-сервера
WEB_PORT=8080

# Только для разработки: API без входа через Telegram
DEV_MODE=0
